# ============================================================
# 完整后端环境变量补充
# 以下配置均为可选项；取消注释后覆盖代码内默认值
# ============================================================

# 服务与节点
# Gin 运行模式；release 减少调试输出，debug 输出调试信息
# GIN_MODE=release
# 覆盖程序构建版本号，通常由镜像或发布流水线注入
# VERSION=
# 收到退出信号后等待请求完成的最长时间，单位为秒
# SHUTDOWN_TIMEOUT_SECONDS=120
# 当前实例的节点名称，用于多节点审计和实例识别
# NODE_NAME=

# 会话、安全与邮件传输
# 缓存键等数据的 HMAC 密钥；留空时沿用 SESSION_SECRET
# CRYPTO_SECRET=
# 是否为 SMTP 连接主动升级到 STARTTLS
# SMTP_STARTTLS_ENABLE=false
# SMTP STARTTLS 的旧版兼容变量；优先使用 SMTP_STARTTLS_ENABLE
# SMTP_STARTTLS_ENABLED=false
# 是否跳过 SMTP TLS 证书校验；生产环境不应启用
# SMTP_INSECURE_SKIP_VERIFY=false
# SMTP TLS 跳过校验的旧版兼容变量；优先使用 SMTP_INSECURE_SKIP_VERIFY
# SMTP_TLS_INSECURE_SKIP_VERIFY=false

# 数据库、日志与 Redis
# ClickHouse 日志表数据保留天数；0 表示不设置 TTL
# LOG_SQL_CLICKHOUSE_TTL_DAYS=0
# Redis 客户端连接池大小
# REDIS_POOL_SIZE=10

# Relay HTTP、请求与流式响应限制
# Relay HTTP 客户端允许保留的最大空闲连接总数
# RELAY_MAX_IDLE_CONNS=500
# Relay HTTP 客户端对每个上游主机保留的最大空闲连接数
# RELAY_MAX_IDLE_CONNS_PER_HOST=100
# 流式响应扫描器单行最大缓冲区，单位为 MB
# STREAM_SCANNER_MAX_BUFFER_MB=128
# 解压后的请求体最大大小，单位为 MB；超限返回 413
# MAX_REQUEST_BODY_MB=128
# 未认证请求允许的请求体大小，单位为 KB
# ANONYMOUS_REQUEST_BODY_LIMIT_KB=512
# 服务端下载远程文件允许的最大大小，单位为 MB
# MAX_FILE_DOWNLOAD_MB=64
# 旧版异步任务轮询间隔，单位为秒；0 表示不额外等待
# POLLING_INTERVAL=0

# API、Web、关键操作和搜索限流
# 是否启用 API 全局速率限制
# GLOBAL_API_RATE_LIMIT_ENABLE=true
# API 全局限流窗口内允许的请求数
# GLOBAL_API_RATE_LIMIT=360
# API 全局限流统计窗口，单位为秒
# GLOBAL_API_RATE_LIMIT_DURATION=180
# 是否启用 Web 管理接口全局速率限制
# GLOBAL_WEB_RATE_LIMIT_ENABLE=true
# Web 管理接口限流窗口内允许的请求数
# GLOBAL_WEB_RATE_LIMIT=120
# Web 管理接口限流统计窗口，单位为秒
# GLOBAL_WEB_RATE_LIMIT_DURATION=180
# 是否启用登录、验证等关键接口的速率限制
# CRITICAL_RATE_LIMIT_ENABLE=true
# 关键接口限流窗口内允许的请求数
# CRITICAL_RATE_LIMIT=20
# 关键接口限流统计窗口，单位为秒
# CRITICAL_RATE_LIMIT_DURATION=1200
# 是否启用搜索接口速率限制
# SEARCH_RATE_LIMIT_ENABLE=true
# 搜索接口限流窗口内允许的请求数
# SEARCH_RATE_LIMIT=10
# 搜索接口限流统计窗口，单位为秒
# SEARCH_RATE_LIMIT_DURATION=60

# Relay 行为和供应商兼容配置
# Gemini 安全过滤阈值；BLOCK_NONE 表示不由网关额外阻止
# GEMINI_SAFETY_SETTING=BLOCK_NONE
# 是否强制向支持的上游发送 stream_options 以获取用量
# FORCE_STREAM_OPTION=true
# 是否在本地计算请求和响应 Token 数量
# CountToken=true
# Azure OpenAI 请求使用的默认 API 版本
# AZURE_DEFAULT_API_VERSION=2025-04-01-preview
# 阿里渠道使用 Anthropic Messages 协议的模型名称匹配词，逗号分隔
# ALI_ANTHROPIC_MESSAGES_MODELS=qwen,deepseek-v4,kimi,glm,minimax-m

# 通知、默认令牌和异步任务
# 同类通知在限流窗口内允许发送的次数
# NOTIFY_LIMIT_COUNT=2
# 通知限流窗口长度，单位为分钟
# NOTIFICATION_LIMIT_DURATION_MINUTE=10
# 单次异步任务轮询最多查询的任务数量
# TASK_QUERY_LIMIT=1000
# 异步任务超时时间，单位为分钟；0 表示禁用超时处理
# TASK_TIMEOUT_MINUTES=1440
# 需要应用特殊任务价格修正的模型或任务标识，多个值以逗号分隔
# TASK_PRICE_PATCH=

# 渠道测试和上游模型同步
# 是否通过环境变量启用定时渠道测试；留空时使用后台系统配置
# CHANNEL_TEST_ENABLED=
# 定时渠道测试间隔，单位为分钟；填写正数时会启用定时测试
# CHANNEL_TEST_FREQUENCY=
# 是否启用定时上游模型列表更新任务
# CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_ENABLED=true
# 上游模型列表更新任务的执行间隔，单位为分钟
# CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_INTERVAL_MINUTES=30
# 同一渠道两次上游模型检查的最小间隔，单位为秒；0 表示不限制
# CHANNEL_UPSTREAM_MODEL_UPDATE_MIN_CHECK_INTERVAL_SECONDS=300
# 上游模型元数据同步服务的基础地址
# SYNC_UPSTREAM_BASE=https://basellm.github.io/llm-metadata
# 模型同步 HTTP 请求超时，单位为秒；留空时由具体同步操作使用代码默认值
# SYNC_HTTP_TIMEOUT_SECONDS=
# 模型同步 HTTP 请求失败后的最大尝试次数
# SYNC_HTTP_RETRY=3
# 模型同步响应体允许的最大大小，单位为 MB
# SYNC_HTTP_MAX_MB=10

# 订阅计划缓存
# 订阅计划列表缓存有效期，单位为秒
# SUBSCRIPTION_PLAN_CACHE_TTL=300
# 单个订阅计划详情缓存有效期，单位为秒
# SUBSCRIPTION_PLAN_INFO_CACHE_TTL=120
# 订阅计划列表缓存的最大条目数
# SUBSCRIPTION_PLAN_CACHE_CAP=5000
# 订阅计划详情缓存的最大条目数
# SUBSCRIPTION_PLAN_INFO_CACHE_CAP=10000

# 前端访问统计
# Umami 网站 ID；留空时不注入 Umami 统计脚本
# UMAMI_WEBSITE_ID=
# Umami 前端统计脚本地址
# UMAMI_SCRIPT_URL=https://analytics.umami.is/script.js
# Google Analytics 4 Measurement ID；留空时不注入统计脚本
# GOOGLE_ANALYTICS_ID=

# Go HTTP 客户端标准代理变量
# 普通 HTTP 上游请求使用的代理地址
# HTTP_PROXY=
# HTTPS 上游请求使用的代理地址
# HTTPS_PROXY=
# 不经过代理的主机或域名列表，多个值以逗号分隔
# NO_PROXY=
