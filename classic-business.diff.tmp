+                  boxShadow: selected
+                    ? 'inset 0 0 0 1px var(--semi-color-primary)'
+                    : undefined,
+                  background: !inMonth
+                    ? 'var(--semi-color-fill-0)'
+                    : commission > 0
+                      ? 'rgba(16, 185, 129, 0.08)'
+                      : commission < 0
+                        ? 'rgba(239, 68, 68, 0.08)'
+                        : undefined,
+                }}
+              >
+                <div className='flex justify-between gap-1'>
+                  <span
