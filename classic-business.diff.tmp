+                    }}
+                  >
+                    {formatBusinessAmount(commission)}
+                  </div>
+                ) : null}
+              </button>
+            );
+          })}
+        </div>
+      </div>
+    </div>
+  );
+
+  if (embedded) {
+    return content;
+  }
+
+  return (
+    <BusinessCard
+      title={t('月度统计')}
+      icon={BadgeDollarSign}
+      color='var(--semi-color-success)'
+      t={t}
