+func flushCustomerCommissionStatsFromRedis() {
+	ctx := context.Background()
+	pattern := customerCommissionStatBufferPrefix + "*"
+	var cursor uint64
+	var flushed int
+	for {
+		keys, nextCursor, err := common.RDB.Scan(ctx, cursor, pattern, 200).Result()
+		if err != nil {
+			common.SysError("flushCustomerCommissionStatsFromRedis: scan error: " + err.Error())
+			return
+		}
+		for _, key := range keys {
+			if flushOneCustomerCommissionKey(ctx, key) {
+				flushed++
+			}
+		}
+		cursor = nextCursor
+		if cursor == 0 {
+			break
+		}
+	}
+	if flushed > 0 {
+		common.SysLog(fmt.Sprintf("flush_business_stats: customer commission redis keys=%d", flushed))
+	}
+}
+
+func flushCommissionMonthlyStatsFromRedis() {
+	ctx := context.Background()
+	pattern := commissionMonthlyStatBufferPrefix + "*"
+	var cursor uint64
+	var flushed int
+	for {
+		keys, nextCursor, err := common.RDB.Scan(ctx, cursor, pattern, 200).Result()
+		if err != nil {
+			common.SysError("flushCommissionMonthlyStatsFromRedis: scan error: " + err.Error())
+			return
+		}
+		for _, key := range keys {
+			if flushOneCommissionMonthlyKey(ctx, key) {
+				flushed++
+			}
+		}
+		cursor = nextCursor
+		if cursor == 0 {
+			break
+		}
+	}
+	if flushed > 0 {
+		common.SysLog(fmt.Sprintf("flush_business_stats: commission monthly redis keys=%d", flushed))
+	}
+}
