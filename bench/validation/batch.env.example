# Local validation profile; supply dedicated SQL/Redis DSNs separately.
# These values do not resolve the batch write-recovery defect in the report.
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=1
MEMORY_CACHE_ENABLED=true
SQL_MAX_IDLE_CONNS=16
SQL_MAX_OPEN_CONNS=64
SQL_MAX_LIFETIME=3600
REDIS_POOL_SIZE=32
REQUEST_LOG_REDIS_DB=1
GIN_MODE=release
TRUSTED_PROXIES=none
